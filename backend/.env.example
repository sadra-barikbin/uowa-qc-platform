NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=university_platform
DB_USER=postgres
DB_PASSWORD=yourpassword
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES=24h

# AI grading (optional) — leave blank to disable. Get a key at https://console.anthropic.com
# (In the packaged desktop app this is NOT set here; the user supplies it in-app and it's stored
#  encrypted. See desktop/README.md.)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Error monitoring (optional) — leave blank to disable. This is the BACKEND Sentry project's DSN
# (the frontend has its own project/DSN, set at build time). A Sentry DSN is safe to expose.
SENTRY_DSN=
# Optional: performance-tracing sample rate (0 disables). Tag runtime events with a
# release via SENTRY_RELEASE (should match the release used to upload source maps).
SENTRY_TRACES_SAMPLE_RATE=
# SENTRY_RELEASE=

# ── Source-map upload (used by `npm run sentry:sourcemaps`) ──
# Normally driven by the desktop release build (desktop/scripts/stage.js), which sets these; listed
# here for running the upload standalone. SENTRY_AUTH_TOKEN is a SECRET — set it in your release
# environment, not here. Scope: project:releases.  Org is EU-hosted, hence the de.sentry.io URL.
# SENTRY_AUTH_TOKEN=
SENTRY_ORG=uowa
SENTRY_PROJECT=backend
SENTRY_URL=https://de.sentry.io/
