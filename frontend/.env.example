# Sentry (error monitoring) for the React frontend.
# Create a separate Sentry project (platform: React) and paste its DSN here.
# If unset, Sentry stays disabled — see src/instrument.js.
REACT_APP_SENTRY_DSN=

# ── Source-map upload (build/release-time only; used by `npm run release`) ──
# SENTRY_AUTH_TOKEN is a SECRET — set it in your CI/release environment, not here.
# Scope needed: project:releases.
# SENTRY_AUTH_TOKEN=
SENTRY_ORG=uowa
SENTRY_PROJECT=frontend
SENTRY_URL=https://de.sentry.io/
