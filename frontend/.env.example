# Sentry (error monitoring) for the React frontend.
# Create a separate Sentry project (platform: React) and paste its DSN here.
# If unset, Sentry stays disabled — see src/instrument.js.
REACT_APP_SENTRY_DSN=

# ── Source-map upload (used by `npm run sentry:sourcemaps`) ──
# Normally driven by the desktop release build (desktop/scripts/stage.js), which sets these; listed
# here for running the upload standalone. SENTRY_AUTH_TOKEN is a SECRET — set it in your
# release environment, not here. Scope needed: project:releases.
# SENTRY_AUTH_TOKEN=
SENTRY_ORG=uowa
SENTRY_PROJECT=frontend
SENTRY_URL=https://de.sentry.io/
